// Paste this into: Firebase console > Firestore Database > Rules > Publish.
// Only the signed-in accounts listed below can read or write anything.
// Use lowercase emails. To add another person later: add a comma and their email inside the
// list (keep the quotes), Publish again, and create their login under Authentication > Users.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function allowed() {
      return request.auth != null
        && request.auth.token.email in [
          'shishir.mmc163@gmail.com'
        ];
    }

    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
